<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Вертикальная направляющая (Разделитель экрана на левую и правую части) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.44" />

    <!-- ==================================================================== -->
    <!-- ЛЕВАЯ КОЛОНКА: Логотип/Название, Кнопка CONNECT, Выбор Сервера       -->
    <!-- Элементы распределены равномерно по вертикали (Chain spread)         -->
    <!-- ==================================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leftSideContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 1. Логотип и Название приложения в самом верху левой колонки -->
        <LinearLayout
            android:id="@+id/leftHeaderBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/buttonAndSpinnerLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/anet_new_round" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="ANet VPN"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Главная кнопка и спиннер подключения (По центру левой колонки) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/buttonAndSpinnerLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/serverSelectContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/leftHeaderBrand">

            <!-- Вращающийся спиннер -->
            <ImageView
                android:id="@+id/connectSpinner"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:elevation="12dp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="@+id/connect"
                app:layout_constraintEnd_toEndOf="@+id/connect"
                app:layout_constraintStart_toStartOf="@+id/connect"
                app:layout_constraintTop_toTopOf="@+id/connect" />

            <!-- Главная кнопка CONNECT / DISCONNECT / STOP -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/connect"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="CONNECT"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:backgroundTint="@null"
                app:cornerRadius="90dp"
                app:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Статус текстом под кнопкой -->
            <TextView
                android:id="@+id/connectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="10dp"
                android:letterSpacing="0.1"
                android:text="DISCONNECTED"
                android:textColor="#FF5252"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/connect"
                app:layout_constraintEnd_toEndOf="@+id/connect"
                app:layout_constraintStart_toStartOf="@+id/connect"
                app:layout_constraintTop_toTopOf="@+id/connect"
                app:layout_constraintVertical_bias="0.68" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3. Выпадающий список выбора ноды (Внизу левой колонки) -->
        <LinearLayout
            android:id="@+id/serverSelectContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/linear_radius"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/buttonAndSpinnerLayout">

            <ImageView
                android:id="@+id/serverIndicator"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/dot"
                app:tint="#9E9E9E" />

            <TextView
                android:id="@+id/serverSelectTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Server 1" />

            <ImageView
                android:id="@+id/serverSelectIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/chevron_down" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ==================================================================== -->
    <!-- ПРАВАЯ КОЛОНКА: Кнопки шапки, Тариф, Статистика, Версия / Логи       -->
    <!-- Элементы распределены равномерно по вертикали (Chain spread)         -->
    <!-- ==================================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rightSideContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingStart="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/guidelineCenter"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 1. Панель действий в шапке (Кнопки Update и Settings) -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="4dp"
            app:layout_constraintBottom_toTopOf="@+id/accountInfoContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread">

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:text="Update"
                android:textColor="@color/buttons_icon_color"
                android:textSize="@dimen/button_font_size"
                app:icon="@drawable/update"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/icon_padding"
                app:iconSize="20dp"
                app:iconTint="#FFFFFF" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="8dp"
                android:text="Settings"
                android:textColor="@color/buttons_icon_color"
                android:textSize="@dimen/button_font_size"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/icon_padding"
                app:iconSize="22dp"
                app:iconTint="#FFFFFF" />
        </LinearLayout>

        <!-- 2. Панель информации об аккаунте (Тариф) -->
        <LinearLayout
            android:id="@+id/accountInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/linear_radius"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@+id/statsContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header">

            <!-- Верхний ряд: Группа и Экспайр -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAccountGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Группа"
                    android:textColor="#EEBC7A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAccountExpires"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Бессрочно"
                    android:textColor="@color/green"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Нижний ряд: 3 колонки (Трафик, Скорость, Сессии) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ТРАФИК"
                        android:textColor="#888888"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvAccountTraffic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—\n/ —"
                        android:textColor="#F2F3F6"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="СКОРОСТЬ"
                        android:textColor="#888888"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvAccountSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#F2F3F6"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="СЕССИИ"
                        android:textColor="#888888"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvAccountSessions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="#F2F3F6"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 3. Панель статистики сети -->
        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/linear_radius"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            app:layout_constraintBottom_toTopOf="@+id/buildInfoBlock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/accountInfoContainer">

            <!-- Верхний ряд: RTT, Download, Upload -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- RTT -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="RTT"
                        android:textColor="#888888"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvRtt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ms"
                        android:textColor="#F2F3F6"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Download (RX) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="↓ DOWNLOAD"
                        android:textColor="#888888"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvRx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 B/s"
                        android:textColor="#F2F3F6"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Upload (TX) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="↑ UPLOAD"
                        android:textColor="#888888"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvTx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 B/s"
                        android:textColor="#F2F3F6"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Разделитель -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="2dp"
                android:background="#383838" />

            <!-- Нижний ряд: Total RX (rxm), Total TX (txm) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Total RX -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="↓ TOTAL RX"
                        android:textColor="#888888"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvRxm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 B"
                        android:textColor="#F2F3F6"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Total TX -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="↑ TOTAL TX"
                        android:textColor="#888888"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tvTxm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 B"
                        android:textColor="#F2F3F6"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 4. Блок информации о сборке / Статус события / Логи -->
        <LinearLayout
            android:id="@+id/buildInfoBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/linear_radius"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/statsContainer">

            <!-- Контейнер для версий (DISCONNECTED) -->
            <LinearLayout
                android:id="@+id/versionInfoContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/versionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="VERSION: v0.0.0 (32)"
                    android:textColor="@color/green"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/buildDetailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="Type: CI/CD | Time: 1989-05-01..."
                    android:textColor="#888888"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- Текст последнего важного события (CONNECTING / CONNECTED) -->
            <TextView
                android:id="@+id/tvVpnEventStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="2"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="[17:03:52] Tunnel UP" />

            <!-- Кнопка логов -->
            <Button
                android:id="@+id/btnShowLogs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="#333333"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="LOG"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>