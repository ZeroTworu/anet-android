<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Выделение пультом (TV D-Pad) или нажатие пальцем -->
    <item android:state_pressed="true">
        <layer-list>
            <item><color android:color="#375417" /></item>
            <item android:bottom="1dp">
                <shape>
                    <solid android:color="#375417" />
                    <stroke android:width="1.5dp" android:color="#669D29" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item><color android:color="#375417" /></item>
            <item android:bottom="1dp">
                <shape>
                    <solid android:color="#375417" />
                    <stroke android:width="1.5dp" android:color="#669D29" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><color android:color="#375417" /></item>
            <item android:bottom="1dp">
                <shape>
                    <solid android:color="#375417" />
                    <stroke android:width="1.5dp" android:color="#669D29" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item><color android:color="#2B3D16" /></item>
            <item android:bottom="1dp"><shape><solid android:color="#669D29" /></shape></item>
        </layer-list>
    </item>

    <!-- Обычное состояние -->
    <item>
        <layer-list>
            <item><color android:color="@color/grey_light" /></item>
            <item android:bottom="1dp"><shape><solid android:color="@color/grey" /></shape></item>
        </layer-list>
    </item>
</selector>
