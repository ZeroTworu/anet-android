<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".MainActivity">

    <!-- Шапка -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal|center_vertical"
        android:orientation="horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:text="update"
            android:textColor="@color/buttons_icon_color"
            android:textSize="@dimen/button_font_size"
            app:icon="@drawable/update"
            app:iconGravity="textTop"
            app:iconPadding="@dimen/icon_padding"
            app:iconTint="#fff" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/anet_new_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="ANet VPN"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="Settings"
            android:textColor="@color/buttons_icon_color"
            android:textSize="@dimen/button_font_size"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textTop"
            app:iconPadding="@dimen/icon_padding"
            app:iconSize="30dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

    <!-- Панель информации об аккаунте (Тариф) -->
    <LinearLayout
        android:id="@+id/accountInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/linear_radius"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <!-- Верхний ряд: Группа и Экспайр -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAccountGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Группа"
                android:textColor="#EEBC7A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAccountExpires"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Бессрочно"
                android:textColor="@color/green"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Нижний ряд: 3 колонки (Трафик, Скорость, Сессии) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ТРАФИК"
                    android:textColor="#888888"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvAccountTraffic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—\n/ —"
                    android:textColor="#F2F3F6"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="СКОРОСТЬ"
                    android:textColor="#888888"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvAccountSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#F2F3F6"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="СЕССИИ"
                    android:textColor="#888888"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/tvAccountSessions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#F2F3F6"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Главный Спиннер подключения -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonAndSpinnerLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toTopOf="@+id/serverSelectContainer"
        app:layout_constraintTop_toBottomOf="@+id/accountInfoContainer">

        <!-- Спиннер -->
        <ImageView
            android:id="@+id/connectSpinner"
            android:layout_width="212dp"
            android:layout_height="212dp"
            android:elevation="12dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/connect"
            app:layout_constraintEnd_toEndOf="@+id/connect"
            app:layout_constraintStart_toStartOf="@+id/connect"
            app:layout_constraintTop_toTopOf="@+id/connect" />

        <!-- Главная кнопка CONNECT / DISCONNECT -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/connect"
            android:layout_width="192dp"
            android:layout_height="192dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08"
            android:text="CONNECT"
            android:textAllCaps="true"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            app:backgroundTint="@null"
            app:cornerRadius="96dp"
            app:elevation="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.45" />

        <!-- Статус текстом — под кнопкой connect -->
        <TextView
            android:id="@+id/connectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="10dp"
            android:letterSpacing="0.1"
            android:text="DISCONNECTED"
            android:textColor="#FF5252"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/connect"
            app:layout_constraintEnd_toEndOf="@+id/connect"
            app:layout_constraintStart_toStartOf="@+id/connect"
            app:layout_constraintTop_toTopOf="@+id/connect"
            app:layout_constraintVertical_bias="0.66" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Выпадающий список выбора ноды -->
    <LinearLayout
        android:id="@+id/serverSelectContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/linear_radius"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toTopOf="@+id/nodeProbeProgressContainer"
        app:layout_constraintEnd_toStartOf="@+id/btnRefreshNodes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonAndSpinnerLayout">

        <ImageView
            android:id="@+id/serverIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/dot"
            app:tint="#9E9E9E" />

        <TextView
            android:id="@+id/serverSelectTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Server 1" />

        <TextView
            android:id="@+id/tvSelectedServerRtt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="..."
            android:textColor="#787C84"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/serverSelectIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/chevron_down" />

    </LinearLayout>

    <!-- Кнопка принудительной перепроверки статуса серверов справа от селектора -->
    <TextView
        android:id="@+id/btnRefreshNodes"
        android:layout_width="42dp"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/linear_radius"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="↻"
        android:textColor="#E0E0E0"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/serverSelectContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/serverSelectContainer" />

    <!-- Индикатор прогресса проверки узлов: ПРОВЕРКА УЗЛОВ X/Y -->
    <LinearLayout
        android:id="@+id/nodeProbeProgressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/buildInfoBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/serverSelectContainer">

        <ProgressBar
            android:id="@+id/pbNodeProbe"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="10"
            android:progressBackgroundTint="#262A36"
            android:progressTint="#38C976" />

        <TextView
            android:id="@+id/tvNodeProbeProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="ПРОВЕРКА УЗЛОВ 0/0"
            android:textColor="#9E9EA6"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Блок информации о сборке / Статус события -->
    <LinearLayout
        android:id="@+id/buildInfoBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/linear_radius"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toTopOf="@+id/statsContainer"
        app:layout_constraintTop_toBottomOf="@+id/nodeProbeProgressContainer">

        <!-- Контейнер для версий (показывается только при DISCONNECTED) -->
        <LinearLayout
            android:id="@+id/versionInfoContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/versionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="VERSION: v0.0.0 (32)"
                android:textColor="@color/green"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/buildDetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Type: CI/CD | Time: 1989-05-01..."
                android:textColor="#888888"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Текст последнего важного события (показывается при CONNECTING / CONNECTED) -->
        <TextView
            android:id="@+id/tvVpnEventStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="[17:03:52] Tunnel UP" />

        <!-- Компактная кнопка открытия логов (справа) -->
        <Button
            android:id="@+id/btnShowLogs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#333333"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="5dp"
            android:text="LOG"
            android:textColor="#fff"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- ПАНЕЛЬ ДИАГНОСТИКИ СВЯЗНОСТИ, ЛИНЕЙНОГО ПУЛЬСА И СКОРОСТИ / ТРАФИКА       -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/statsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/linear_radius"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buildInfoBlock">

        <!-- 1. Щит состояния сети (Детектор связности: работает ВСЕГДА) -->
        <LinearLayout
            android:id="@+id/connectivityShieldCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">

            <!-- Верхняя строка щита: цветовой индикатор + вердикт + счётчик узлов + кнопка проверки -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/connectivityBadgeDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="7dp"
                    android:src="@drawable/dot"
                    app:tint="#FFC107" />

                <TextView
                    android:id="@+id/tvConnectivityTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Метеосводка: проверка связи…"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvConnectivityNodes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="monospace"
                    android:text="РФ — • Мир —"
                    android:textColor="#9E9E9E"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/btnRecheckConnectivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:text="↻"
                    android:textColor="#EEBC7A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Подзаголовок вердикта (эзопов язык / ироничное описание 6 состояний) -->
            <TextView
                android:id="@+id/tvConnectivitySubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Опрашиваем ближние и дальние маяки…"
                android:textColor="#AAAAAA"
                android:textSize="10sp" />

            <!-- Сегментированная шкала ответивших узлов (РФ + Мир) -->
            <org.alco.anet.ConnectivitySegmentsView
                android:id="@+id/connectivitySegmentsView"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="7dp"
            android:background="#2A2A2E" />

        <!-- 2. Линейный пульс пинга ("Вы ───────●── 📶 58 мс Сеть/Сервер") -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Вы"
                android:textColor="#F2F3F6"
                android:textSize="11sp"
                android:textStyle="bold" />

            <org.alco.anet.PulseLineView
                android:id="@+id/pulseLineView"
                android:layout_width="0dp"
                android:layout_height="18dp"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRtt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:fontFamily="monospace"
                android:text="— мс"
                android:textColor="#00E676"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPulseTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="84dp"
                android:text="Сеть"
                android:textColor="#F2F3F6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="7dp"
            android:background="#2A2A2E" />

        <!-- 3. Карточка СКОРОСТЬ / ТРАФИК с живым графиком (Sparkline) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Верхний ряд: текущая скорость (↓/↑) слева и общий трафик за сессию справа -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- СКОРОСТЬ (RX / TX) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="СКОРОСТЬ"
                        android:textColor="#888888"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↓ "
                            android:textColor="#00E676"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvRx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 B/s"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="↑ "
                            android:textColor="#EEBC7A"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvTx"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 B/s"
                            android:textColor="#BDBDBD"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- СЕССИЯ (TOTAL RX / TOTAL TX) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:text="ЗА СЕССИЮ"
                        android:textColor="#888888"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="↓ "
                            android:textColor="#00E676"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvRxm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 B"
                            android:textColor="#F2F3F6"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="↑ "
                            android:textColor="#EEBC7A"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/tvTxm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 B"
                            android:textColor="#BDBDBD"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Живая кривая скорости за 60 секунд -->
            <org.alco.anet.TelemetrySparklineView
                android:id="@+id/telemetrySparklineView"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
